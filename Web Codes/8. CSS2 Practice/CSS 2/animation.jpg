 <!DOCTYPE html>

<!-- Fig. 5.11: animation.html -->
 <!-- Animation in CSS3. -->
 <html>
 <head>
 <meta charset = "utf-8">
 <title>Animation</title>
 <style type = "text/css">
 img
 {
 position: relative;
-webkit-animation: movingImage linear 10s 1s 2 alternate;
-moz-animation: movingImage linear 10s 1s 2 alternate;
animation: movingImage linear 10s 2 1s alternate;16 }

</style>
 </head>
 <body>
 <img src = "1.jpg" width = "138" height = "180"
 alt = "Java How to Program book cover">
 <div></div>
 </body>
 </html>

